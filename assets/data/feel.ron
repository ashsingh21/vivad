// Movement feel tunables (crates/game/src/feel.rs). The game rereads this file while it runs:
// change a number, save, and the next frame uses it. `just feelcheck` measures the result.
(
    // How fast clip weights move to their targets: every blend (start, stop, slide, landing) eases
    // in and out, 90% done in about 3.9 / blend_rate seconds (28: 0.14 s; Fortnite-quick).
    blend_rate: 28.0,
    // How fast the legs slow when the body does, per second: a stop's strides run out over about
    // 2.3 / stop_ease seconds (24: 0.1 s) instead of freezing mid-step.
    stop_ease: 24.0,
    // How fast the drawn body turns to face its way, per second: aiming or holding a gun, and not.
    turn_rate_fight: 24.0,
    turn_rate: 18.0,
    // Lean into turns: radians per (rad/s of turn x m/s of speed), and the most (0.14 is 8 deg).
    lean_gain: 0.012,
    lean_max: 0.14,
)
